{
  "models": [
    {
      "id": "gpt_image_2",
      "name": "GPT Image 2",
      "provider": "openai",
      "kind": "image",
      "endpoint": "gpt-image-2",
      "price": "billed per image by size/quality (see OpenAI pricing)",
      "notes": "Flexible sizes: each edge a multiple of 16, max edge 3840, ratio within 3:1, total pixels 655360-8294400. Returns base64; input_fidelity is always high and cannot be set. Pass --image to edit instead of generate.",
      "params": [
        {"name": "prompt", "type": "string", "required": true, "desc": "text description (up to 32000 chars)"},
        {"name": "image", "type": "string[]", "media": "image", "desc": "input image(s) — switches to the edits endpoint"},
        {"name": "mask", "type": "string", "media": "image", "desc": "PNG mask; applied to the first input image"},
        {"name": "n", "type": "int", "default": 1, "min": 1, "max": 10, "desc": "number of images"},
        {"name": "size", "type": "string", "default": "auto", "desc": "auto, 1024x1024, 1536x1024, 1024x1536, or WIDTHxHEIGHT"},
        {"name": "quality", "type": "string", "default": "auto", "enum": ["auto", "low", "medium", "high"], "desc": "render quality"},
        {"name": "background", "type": "string", "enum": ["transparent", "opaque", "auto"], "desc": "background handling"},
        {"name": "output_format", "type": "string", "default": "png", "enum": ["png", "jpeg", "webp"], "desc": "encoding of the returned image"},
        {"name": "output_compression", "type": "int", "min": 0, "max": 100, "desc": "compression percent for jpeg/webp"},
        {"name": "moderation", "type": "string", "enum": ["auto", "low"], "desc": "moderation strictness"},
        {"name": "user", "type": "string", "desc": "end-user identifier for abuse tracking"}
      ]
    },
